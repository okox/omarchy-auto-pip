# Auto picture-in-picture settings: ~/.config/auto-pip/config
# Plain shell variables. After a change: systemctl --user restart auto-pip

# Browser window classes to watch (regex, any case).
#BROWSERS='chromium|chrome|brave|vivaldi|microsoft-edge'

# Video players whose own window becomes the PiP: window classes (regex, any
# case; see `hyprctl clients`). Empty = browsers only.
#PLAYERS='mpv|vlc|celluloid'

# Browsers: only pop out from windows whose title matches (regex). Empty = any page.
# Example, YouTube and Twitch only:
#TITLE='YouTube|Twitch'

# Size of the first PiP, and the gap to the screen corner. Once you drag or
# resize a PiP, it opens there from then on.
#SIZE='480 270'
#MARGIN=12

# The extension's shortcuts. Change both here and in chrome://extensions/shortcuts.
#MODS='ALT SHIFT'
#OPEN_KEY=8
#CLOSE_KEY=9

# Notification when switched on or off (0 = none).
#NOTIFY=1

# Where the PiP's spot is remembered.
#SPOT_FILE="$HOME/.local/state/auto-pip/spot"
