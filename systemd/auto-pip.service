[Unit]
Description=Auto picture-in-picture when you leave a desktop with a playing video
Documentation=https://github.com/okox/omarchy-auto-pip
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/auto-pip watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
