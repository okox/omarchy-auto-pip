#!/bin/bash
# Auto picture-in-picture for Hyprland.
#
# Leave a desktop where a video is playing and it follows you in a small
# pinned window on every desktop. Go back to that desktop and it pops back in.
# Kinds of source:
#   browsers  the video pops out into the browser's own picture-in-picture
#             window and carries on in its tab when it closes. Chromium-based
#             ones through the extension in ../extension, Firefox-based ones
#             through Firefox's own Ctrl+Shift+] toggle
#   players   the player's own window (mpv, VLC, Celluloid...) shrinks into the
#             corner, then returns to its size, place and fullscreen
# The PiP moves to whichever monitor you're on, same corner.
#
#   auto-pip watch                 the watcher (run by auto-pip.service)
#   auto-pip on | off | toggle     switch it on or off (also closes an open PiP)
#   auto-pip status                prints "on" or "off"
#   auto-pip close                 close the PiP it opened, now
#
# Settings: ~/.config/auto-pip/config (see examples/config).

VERSION=1.3.0

# ---------------------------------------------------------------- settings --
BROWSERS='chromium|chrome|brave|vivaldi|microsoft-edge' # Chromium-based browser classes (regex, any case)
FIREFOXES='firefox|librewolf|zen|floorp|waterfox' # Firefox-based browser classes; empty = none
TITLE=''                       # browsers: only windows whose title matches (regex); empty = any
PLAYERS='mpv|vlc|celluloid'    # player window classes (regex, any case); empty = none
SIZE='480 270'                 # first-time PiP size; afterwards it remembers yours
MARGIN=12                      # gap to the screen corner
MODS='ALT SHIFT' OPEN_KEY=8 CLOSE_KEY=9 # must match the extension's shortcuts
FF_MODS='CTRL SHIFT' FF_KEY=bracketright  # Firefox's own picture-in-picture toggle
NOTIFY=1                       # notification when switched on/off
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/auto-pip"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/auto-pip"
SPOT_FILE="$STATE_DIR/spot"    # "x y w h" where you last left the PiP
# shellcheck source=/dev/null
[[ -r $CONF_DIR/config ]] && . "$CONF_DIR/config"

OFF="$STATE_DIR/off"           # exists = switched off
RUN="${XDG_RUNTIME_DIR:-/run/user/$UID}/auto-pip"
# While a PiP is open:
#   browser|firefox <browser window> <home desktop>
#   player  <player window> <home desktop> <x> <y> <w> <h> <fullscreen> <floating>
state="$RUN/open"
PIP_TITLE='^Picture.?in.?[Pp]icture$'
TAG=auto-pip                   # window tag on a player while it is the PiP
read -r PIP_W PIP_H <<<"$SIZE"
mkdir -p "$STATE_DIR" "$RUN"

# ----------------------------------------------------------------- helpers --
disp() { hyprctl dispatch "$1" >/dev/null 2>&1; }

key() { # $1 = window address, $2 = modifiers, $3 = key: send that shortcut to the window
  disp "hl.dsp.send_shortcut({ mods = \"$2\", key = \"$3\", window = \"address:$1\" })"
}

pip_key() { # $1 = window address, $2 = browser kind, $3 = open | close
  if [[ $2 == firefox ]]; then key "$1" "$FF_MODS" "$FF_KEY" # one key toggles it
  elif [[ $3 == open ]]; then key "$1" "$MODS" "$OPEN_KEY"
  else key "$1" "$MODS" "$CLOSE_KEY"; fi
}

active_desktop() { hyprctl activeworkspace -j | jq -r .id; }

client() { # $1 = address: that window as JSON, empty if it's gone
  hyprctl clients -j | jq -c --arg a "$1" 'first(.[] | select(.address == $a and .mapped)) // empty'
}

pip_window() { # a browser's PiP window as JSON, empty if none
  hyprctl clients -j | jq -c --arg t "$PIP_TITLE" 'first(.[] | select(.mapped and (.title | test($t)))) // empty'
}

media() { # $1 = pid: Playing / Paused / Stopped from its MPRIS player, "none" if it has none
  local names name s out=none
  # matched by the bus connection's pid, or by the pid browsers put in the name
  names=$(busctl --user list --no-legend --no-pager 2>/dev/null |
    awk -v p="$1" '$1 ~ /^org\.mpris\.MediaPlayer2\./ && ($2 == p || $1 ~ "\\.instance" p "$") {print $1}')
  for name in $names; do
    s=$(busctl --user get-property "$name" /org/mpris/MediaPlayer2 \
      org.mpris.MediaPlayer2.Player PlaybackStatus 2>/dev/null | awk -F'"' '{print $2}')
    [[ $s == Playing ]] && { echo Playing; return; }
    [[ -n $s ]] && out=$s
  done
  echo "$out"
}

sources_on() { # $1 = desktop: "kind address pid" per browser/player window there, most recently used first
  hyprctl clients -j | jq -r --argjson ws "$1" --arg b "$BROWSERS" --arg f "$FIREFOXES" --arg t "$TITLE" \
    --arg pl "$PLAYERS" --arg p "$PIP_TITLE" '
    [.[] | select(.workspace.id == $ws and .mapped and (.pinned | not) and (.title | test($p) | not))
         | if $f != "" and (.class | test($f; "i")) and (.title | test($t)) then . + {kind: "firefox"}
           elif (.class | test($b; "i")) and (.title | test($t)) then . + {kind: "browser"}
           elif $pl != "" and (.class | test("^(" + $pl + ")$"; "i")) then . + {kind: "player"}
           else empty end]
    | sort_by(.focusHistoryID) | .[] | "\(.kind) \(.address) \(.pid)"'
}

no_titlebar() { # Omarchy draws a title bar on windows on floating desktops; not on the PiP
  disp "hl.dsp.window.tag({ window = \"address:$1\", tag = \"-omarchy-floating-workspace\" })"
}

raise() { disp "hl.dsp.window.alter_zorder({ window = \"address:$1\", mode = \"top\" })"; }

# Monitor maths, in layout pixels. reserved = [left, top, right, bottom] (the bar).
JQ_MON='
  def g: {x, y, w: (.width / .scale | floor), h: (.height / .scale | floor),
          l: .reserved[0], t: .reserved[1], r: .reserved[2], b: .reserved[3]};
  def holds($x; $y; $w; $h): g as $m |
    ($x + $w / 2) >= $m.x and ($x + $w / 2) < $m.x + $m.w and ($y + $h / 2) >= $m.y and ($y + $h / 2) < $m.y + $m.h;
  # the same corner and gaps on monitor $d as on monitor $s, shrunk to fit
  def carry($s; $d; $x; $y; $w; $h): ($s | g) as $S | ($d | g) as $D |
    ([$w, $D.w - $D.l - $D.r] | min) as $nw | ([$h, $D.h - $D.t - $D.b] | min) as $nh |
    ($x - $S.x - $S.l) as $gl | ($S.x + $S.w - $S.r - $x - $w) as $gr |
    ($y - $S.y - $S.t) as $gt | ($S.y + $S.h - $S.b - $y - $h) as $gb |
    (if $gl <= $gr then $D.x + $D.l + $gl else $D.x + $D.w - $D.r - $gr - $nw end) as $nx |
    (if $gt <= $gb then $D.y + $D.t + $gt else $D.y + $D.h - $D.b - $gb - $nh end) as $ny |
    "\([[$nx, $D.x + $D.l] | max, $D.x + $D.w - $D.r - $nw] | min | floor) \([[$ny, $D.y + $D.t] | max, $D.y + $D.h - $D.b - $nh] | min | floor) \($nw) \($nh)";
'

spot() { # prints "x y w h" on the monitor you're on: the remembered spot (carried
  # over to this monitor if you left it on another), else the bottom-right corner
  local mons sx sy sw sh
  mons=$(hyprctl monitors -j)
  if [[ -s $SPOT_FILE ]] && read -r sx sy sw sh <"$SPOT_FILE" && [[ "$sx$sy$sw$sh" =~ ^-?[0-9-]+$ ]] &&
    ((sw >= 160 && sh >= 90)); then
    jq -r --argjson x "$sx" --argjson y "$sy" --argjson w "$sw" --argjson h "$sh" "$JQ_MON"'
      first(.[] | select(.focused)) as $d | (first(.[] | select(holds($x; $y; $w; $h))) // $d) as $s |
      carry($s; $d; $x; $y; $w; $h)' <<<"$mons" && return
  fi
  jq -r --argjson w "$PIP_W" --argjson h "$PIP_H" --argjson m "$MARGIN" "$JQ_MON"'
    first(.[] | select(.focused)) | g | "\(.x + .w - .r - $w - $m) \(.y + .h - .b - $h - $m) \($w) \($h)"' <<<"$mons"
}

follow_monitor() { # the PiP onto the monitor you're on, same corner (pinned windows stay on theirs)
  local w mons to
  w=$(current)
  [[ -n $w ]] && in_pip "$w" || return
  mons=$(hyprctl monitors -j)
  to=$(jq -r --argjson w "$w" "$JQ_MON"'
    first(.[] | select(.focused)) as $d | select($d.id != $w.monitor) |
    first(.[] | select(.id == $w.monitor)) as $s |
    carry($s; $d; $w.at[0]; $w.at[1]; $w.size[0]; $w.size[1]) + " " + $d.name' <<<"$mons")
  [[ -n $to ]] || return
  local x y pw ph name addr
  read -r x y pw ph name <<<"$to"
  addr=$(jq -r .address <<<"$w")
  disp "hl.dsp.window.move({ window = \"address:$addr\", monitor = \"$name\" })"
  # Hyprland settles the monitor move a moment later: place it until it stays put
  for _ in 1 2 3 4; do
    disp "hl.dsp.window.resize({ window = \"address:$addr\", x = $pw, y = $ph })"
    disp "hl.dsp.window.move({ window = \"address:$addr\", x = $x, y = $y })"
    sleep 0.1
    jq -e --argjson x "$x" --argjson y "$y" '((.at[0] - $x) | fabs) <= 2 and ((.at[1] - $y) | fabs) <= 2' \
      <<<"$(client "$addr")" >/dev/null && break
  done
  raise "$addr"
}

current() { # the open PiP's window as JSON, empty if none
  local kind addr
  [[ -s $state ]] || return
  read -r kind addr _ <"$state"
  if [[ $kind == player ]]; then client "$addr"; else pip_window; fi
}

remember() { # save where the PiP is, after you've dragged or resized it
  local w
  w=$(current)
  [[ -n $w && $(jq .pinned <<<"$w") == true ]] || return
  jq -r '"\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"' <<<"$w" >"$SPOT_FILE.tmp" && mv "$SPOT_FILE.tmp" "$SPOT_FILE"
}

focused_on() { # $1 = desktop: the window you were using there (empty if none)
  # Right after a desktop change Hyprland may not have focused one yet, so fall
  # back to the most recently used window. Pinned windows (PiPs) don't count.
  hyprctl clients -j | jq -r --argjson ws "$1" --arg t "$PIP_TITLE" '
    [.[] | select(.workspace.id == $ws and .mapped and (.pinned | not) and (.title | test($t) | not))]
    | sort_by(.focusHistoryID) | first(.[].address) // empty'
}

refocus() { # $1 = window to give the keyboard back to (sending a key moves it), $2 = desktop
  # Only while you're still on that desktop: focusing a window elsewhere would
  # switch you back there.
  [[ -n $1 && $(active_desktop) == "$2" ]] && disp "hl.dsp.focus({ window = \"address:$1\" })"
}

# ---------------------------------------------------------------- browsers --
browser_open() { # $1 = browser window, $2 = its desktop, $3 = desktop we're on, $4 = browser | firefox
  local before w x y pw ph
  before=$(focused_on "$3")
  pip_key "$1" "$4" open
  local n
  for try in 1 2; do
    # a video in the tab in front opens in ~0.3 s; give the second press longer
    [[ $try == 1 ]] && n=6 || n=12
    for ((i = 0; i < n; i++)); do
      sleep 0.1
      w=$(pip_window)
      [[ -n $w ]] && break 2
    done
    # The video may be in a background tab: the extension brought it forward
    # on the first press, the second press opens the PiP.
    [[ $try == 1 && $4 == browser ]] || break
    pip_key "$1" "$4" open
  done
  refocus "$before" "$3"
  [[ -n $w ]] || return 1 # nothing was playing in that window's tab
  echo "$4 $1 $2" >"$state"
  read -r x y pw ph <<<"$(spot)"
  local addr
  addr=$(jq -r .address <<<"$w")
  no_titlebar "$addr"
  disp "hl.dsp.window.resize({ window = \"address:$addr\", x = $pw, y = $ph })"
  disp "hl.dsp.window.move({ window = \"address:$addr\", x = $x, y = $y })"
  raise "$addr"
}

browser_close() { # $1 = browser window, $2 = its desktop, $3 = browser | firefox
  local here before w
  here=$(active_desktop)
  before=$(focused_on "$here")
  pip_key "$1" "$3" close # keeps the video playing in its tab
  # switched off from another desktop: keep typing where you were, not in the browser
  [[ $here != "$2" ]] && refocus "$before" "$here"
  sleep 0.4
  w=$(pip_window)
  # the tab was changed meanwhile: close the window itself
  [[ -n $w ]] && disp "hl.dsp.window.close({ window = \"address:$(jq -r .address <<<"$w")\" })"
}

# ----------------------------------------------------------------- players --
in_pip() { jq -e '.pinned and .floating and .fullscreen == 0' <<<"$1" >/dev/null; }

player_enter() { # $1 = player window address, $2 = desktop we're on
  local addr=$1 win="address:$1" w x y pw ph prev
  w=$(client "$addr")
  [[ -n $w ]] || return 1
  # a repair keeps what it saved the first time
  [[ -s $state ]] || jq -r '"player \(.address) \(.workspace.id) \(.at[0]) \(.at[1]) \(.size[0]) \(.size[1]) \(.fullscreen) \(.floating)"' <<<"$w" >"$state"
  read -r x y pw ph <<<"$(spot)"
  # Omarchy tiles a window its floating desktop floated as soon as it lands on
  # a tiled desktop, which would undo the floating (and the pin) below.
  disp "hl.dsp.window.tag({ window = \"$win\", tag = \"-omarchy-mode-floated\" })"
  # Omarchy and the fullscreen change react a moment later, so check and redo
  # until it really is a pinned floating window in its spot.
  for _ in 1 2 3 4 5 6; do
    w=$(client "$addr")
    [[ -n $w ]] || return 1
    # bring it here first: focusing it on its own desktop would switch back there
    [[ $(jq .pinned <<<"$w") == true || $(jq -r .workspace.id <<<"$w") == "$2" ]] ||
      disp "hl.dsp.window.move({ workspace = \"$2\", follow = false, window = \"$win\" })"
    if [[ $(jq .fullscreen <<<"$w") != 0 ]]; then
      prev=$(hyprctl activewindow -j | jq -r '.address // empty')
      disp "hl.dsp.focus({ window = \"$win\" })"
      disp 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "unset" })'
      disp 'hl.dsp.window.fullscreen({ mode = "maximized", action = "unset" })'
      [[ -n $prev && $prev != "$addr" ]] && disp "hl.dsp.focus({ window = \"address:$prev\" })"
    fi
    [[ $(jq .floating <<<"$w") == true ]] || disp "hl.dsp.window.float({ window = \"$win\", action = \"set\" })"
    disp "hl.dsp.window.resize({ window = \"$win\", x = $pw, y = $ph })"
    disp "hl.dsp.window.move({ window = \"$win\", x = $x, y = $y })"
    # pin toggles: only when it isn't pinned yet
    [[ $(jq .pinned <<<"$(client "$addr")") == true ]] || disp "hl.dsp.window.pin({ window = \"$win\" })"
    raise "$addr"
    disp "hl.dsp.window.tag({ window = \"$win\", tag = \"+$TAG\" })"
    no_titlebar "$addr"
    sleep 0.15
    jq -e --argjson x "$x" --argjson y "$y" \
      '.pinned and .floating and .fullscreen == 0 and ((.at[0] - $x) | fabs) <= 4 and ((.at[1] - $y) | fabs) <= 4' \
      <<<"$(client "$addr")" >/dev/null && return 0
  done
}

player_leave() { # back to its desktop, size, place and fullscreen (from the state file)
  local kind addr home x y w h fs fl win cur
  read -r kind addr home x y w h fs fl <"$state"
  win="address:$addr"
  cur=$(client "$addr")
  [[ -n $cur ]] || return
  [[ $(jq .pinned <<<"$cur") == true ]] && disp "hl.dsp.window.pin({ window = \"$win\" })"
  disp "hl.dsp.window.tag({ window = \"$win\", tag = \"-$TAG\" })"
  # Omarchy's floating-desktop tag (picked up if the PiP visited a floating
  # desktop) would make Omarchy flip it back to floating on a tiled one.
  disp "hl.dsp.window.tag({ window = \"$win\", tag = \"-omarchy-mode-floated\" })"
  disp "hl.dsp.window.move({ workspace = \"$home\", follow = false, window = \"$win\" })"
  if command -v omarchy-hyprland-workspace-layout-current >/dev/null &&
    [[ $(omarchy-hyprland-workspace-layout-current "$home") == floating ]]; then
    # back under Omarchy's floating desktop's care, as it was before
    disp "hl.dsp.window.tag({ window = \"$win\", tag = \"+omarchy-mode-floated\" })"
    disp "hl.dsp.window.tag({ window = \"$win\", tag = \"+omarchy-floating-workspace\" })"
    disp "hl.dsp.window.resize({ window = \"$win\", x = $w, y = $h })"
    disp "hl.dsp.window.move({ window = \"$win\", x = $x, y = $y })"
  elif [[ $fl == true ]]; then # it was floating there before: as it was
    no_titlebar "$addr"
    disp "hl.dsp.window.resize({ window = \"$win\", x = $w, y = $h })"
    disp "hl.dsp.window.move({ window = \"$win\", x = $x, y = $y })"
  else
    # tiled again; Omarchy may still react a moment later, so check
    no_titlebar "$addr"
    for _ in 1 2 3 4; do
      [[ $(jq .floating <<<"$(client "$addr")") == true ]] || break
      disp "hl.dsp.window.float({ window = \"$win\", action = \"unset\" })"
      sleep 0.15
    done
  fi
  if [[ $fs != 0 ]]; then
    disp "hl.dsp.focus({ window = \"$win\" })"
    disp 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set" })'
  fi
}

# ------------------------------------------------------------ open / close --
open_from() { # $1 = desktop we left, $2 = desktop we're on
  [[ -e $OFF || -s $state ]] && return
  [[ -n $(pip_window) ]] && return # a PiP you opened yourself is up
  local list kind addr pid s
  list=$(sources_on "$1")
  [[ -n $list ]] || return
  sleep 0.15 # let Hyprland finish switching and focus a window there
  [[ $(active_desktop) == "$2" ]] || return # moved on again
  while read -r kind addr pid; do
    s=$(media "$pid")
    if [[ $kind != player ]]; then
      [[ $s == Playing ]] && browser_open "$addr" "$1" "$2" "$kind" && return
    else
      # a player that doesn't report its playback counts as playing
      [[ $s == Playing || $s == none ]] && { player_enter "$addr" "$2"; return; }
    fi
  done <<<"$list"
}

close_pip() { # back on its desktop, or switched off
  local kind addr home
  [[ -s $state ]] || return 0
  read -r kind addr home _ <"$state"
  if [[ $kind != player ]]; then
    rm -f "$state"
    browser_close "$addr" "$home" "$kind"
  else
    remember
    player_leave
    rm -f "$state"
  fi
}

# ------------------------------------------------------------------ switch --
switch() { # $1 = on | off
  if [[ $1 == off ]]; then
    : >"$OFF"
    close_pip
    [[ $NOTIFY == 1 ]] && notify-send -a "Picture-in-picture" -t 2000 "Auto picture-in-picture off" "Videos stay on their desktop."
  else
    rm -f "$OFF"
    [[ $NOTIFY == 1 ]] && notify-send -a "Picture-in-picture" -t 2000 "Auto picture-in-picture on" "Leave a desktop with a playing video to get a PiP."
  fi
  # your own extras: ~/.config/auto-pip/on-switch on|off
  [[ -x $CONF_DIR/on-switch ]] && "$CONF_DIR/on-switch" "$1"
  # the bar icon, if it's there
  command -v omarchy-shell >/dev/null && omarchy-shell -q okox.auto-pip refresh >/dev/null 2>&1
  return 0
}

# ----------------------------------------------------------------- watcher --
on_desktop() { # $1 = desktop we switched to
  [[ $1 =~ ^[0-9]+$ ]] || return # ignore special workspaces
  local from=$prev kind addr home w
  prev=$1
  # already on another desktop again (switches pile up while we wait): act on the newest only
  [[ $(active_desktop) == "$1" ]] || return
  if [[ -s $state ]]; then
    read -r kind addr home _ <"$state"
    w=$(current)
    if [[ -z $w ]]; then
      rm -f "$state" # you closed it yourself
    elif [[ $1 == "$home" || -e $OFF ]]; then
      close_pip
      return
    elif [[ $kind == player ]] && ! in_pip "$w"; then
      player_enter "$addr" "$1" # something undid the PiP: do it again
      return
    else
      follow_monitor # a desktop on another monitor: bring it along
      # Omarchy re-adds the title-bar tag on floating desktops
      ( exec 8>&-; a=$(jq -r .address <<<"$w"); for t in 0.05 0.25; do sleep $t; no_titlebar "$a"; raise "$a"; done ) &
      return
    fi
  fi
  [[ $from =~ ^[0-9]+$ && $from != "$1" ]] && open_from "$from" "$1"
}

watch() {
  local sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
  [[ -S $sock ]] || { echo "auto-pip: no Hyprland session found" >&2; exit 1; }
  exec 8>"$RUN/lock"
  flock -n 8 || { echo "auto-pip: already running" >&2; exit 0; }
  prev=$(active_desktop)
  # restarted while a PiP is up: keep it, and fix it up for this desktop
  if [[ -s $state ]]; then
    if [[ -n $(current) ]]; then on_desktop "$prev"; else rm -f "$state"; fi
  fi
  trap 'pkill -P $$ 2>/dev/null' EXIT
  trap 'exit 0' TERM INT
  socat -U - "UNIX-CONNECT:$sock" 8>&- | while IFS= read -r line; do
    case $line in
      workspacev2\>\>*) id=${line#*>>}; on_desktop "${id%%,*}" ;;
      # after a drag or resize you click or focus something: save the spot
      activewindowv2\>\>* | movewindowv2\>\>*)
        [[ -s $state ]] && { remember; w=$(current); [[ -n $w ]] && in_pip "$w" && raise "$(jq -r .address <<<"$w")"; } ;;
      # clicked or moved over to another monitor
      focusedmonv2\>\>*) [[ -s $state ]] && follow_monitor ;;
      closewindow\>\>*) [[ -s $state && -z $(current) ]] && rm -f "$state" ;;
    esac
  done
  exit 1 # Hyprland went away (or socat failed); systemd restarts us if it's back
}

# -------------------------------------------------------------------- main --
case ${1:-} in
  watch) watch ;;
  on | off) switch "$1" ;;
  toggle) [[ -e $OFF ]] && switch on || switch off ;;
  status) [[ -e $OFF ]] && echo off || echo on ;;
  close) close_pip; exit 0 ;;
  --version | version) echo "auto-pip $VERSION" ;;
  *) sed -n 's/^#   \(auto-pip .*\)/  \1/p' "$0"; [[ ${1:-} =~ ^(-h|--help|help)$ ]] || exit 2 ;;
esac
